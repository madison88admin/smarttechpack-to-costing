NEXTGEN_BASE_URL=https://nextgen.madison88.com
NEXTGEN_USERNAME=replace-me
NEXTGEN_PASSWORD=replace-me

# Optional NextGen BOM tuning (defaults shown)
# NEXTGEN_BOM_ENTITY_TYPE=23
# NEXTGEN_BOM_FILTER_FIELD=ProductId
# NEXTGEN_BOM_FILTER_OPERATOR=eq
# NEXTGEN_BOM_PAGE_SIZE=200
# NEXTGEN_BOM_USER_AREA_CLAIM=FullAccess
# NEXTGEN_BOM_SHOW_TABS=False
# NEXTGEN_BOM_VIEWCACHE_PATH=/ViewCache/BillOfMaterial

NEXT_PUBLIC_SUPABASE_URL=http://5.223.78.194:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
TP_COSTING_ENABLE_SUPABASE_AUTH=true
TP_COSTING_SSO_PROVIDER=
TP_COSTING_SESSION_SECRET=replace-with-at-least-32-random-characters
# Temporary migration switch only; keep false in production.
TP_COSTING_ENABLE_LEGACY_PASSWORD_LOGIN=false

# Notification settings (BR-011, FR-009)
# Fallback email when no specific recipients are configured
# NOTIFICATION_FALLBACK_EMAIL=costing-team@madison88.com
# Escalation email for overdue requests (defaults to fallback if not set)
# ESCALATION_EMAIL=costing-manager@madison88.com
# Sender email address for outgoing notifications
# NOTIFICATION_FROM_EMAIL=no-reply@madison88.com
# Public app URL for links in notification body
# NEXT_PUBLIC_APP_URL=http://localhost:3111

# Microsoft Graph API (constraint C-001: MS365 ecosystem)
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=

# SMTP fallback (if Graph API not configured)
# SMTP_URL=
# SMTP_USER=
# SMTP_PASS=

# Microsoft Teams incoming webhook URL
# TEAMS_WEBHOOK_URL=

# Cron secret for /api/notifications/process endpoint
# CRON_SECRET=

# LLM (Qwen3 on VPS via Ollama OpenAI-compatible API)
LLM_BASE_URL=http://your-llm-server:11434/v1
LLM_MODEL=qwen3:4b
LLM_API_KEY=your-llm-api-key-here
# Optional local-only pilot login. Keep disabled in production. Passwords must
# never be committed; define the JSON only in .env.local when explicitly needed.
TP_COSTING_ENABLE_PILOT_LOGIN=false
TP_COSTING_PILOT_USERS_JSON={}
